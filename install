#!/usr/bin/env bash
xcode-select --install
sudo xcodebuild -license

pip3 install --ignore-installed ansible

# Set up PATH for Python user packages and Homebrew
PYTHON_USER_BASE=$(python3 -m site --user-base)
export PATH="/opt/homebrew/bin:${PYTHON_USER_BASE}/bin:$PATH"

ansible-playbook local.yml --ask-become-pass --ask-vault-pass
